FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY seed_dummy_data.go ./

# Build the application
RUN go build -o seed_dummy_data seed_dummy_data.go

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

# Copy the binary from builder stage
COPY --from=builder /app/seed_dummy_data .

# Run the seeder
CMD ["./seed_dummy_data"]