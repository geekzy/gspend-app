FROM mongo:7.0

# Install dependencies
RUN apt-get update && apt-get install -y curl jq && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy scripts
# Note: These paths are relative to the build context (repo root)
COPY scripts/integration-test.sh /app/scripts/integration-test.sh
COPY apps/financial-service/scripts/create_indexes.sh /app/bin/create-indexes
COPY apps/financial-service/scripts/seed_categories.sh /app/bin/seed-categories

# Make scripts executable
RUN chmod +x /app/scripts/integration-test.sh /app/bin/create-indexes /app/bin/seed-categories

# Create test-results directory
RUN mkdir -p /app/test-results

ENTRYPOINT ["/app/scripts/integration-test.sh"]
